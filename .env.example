# A hg25ccs titkai. Másold .env néven a hg25ccs/ mappába.
# A .gitignore már kizárja a .env-et, szóval nem kerül be a repóba.

# Az admin session tokenek aláírókulcsa (auth.py).
# ⚠️ ÉLESBEN cseréld le: openssl rand -hex 32
CCS_AUTH_SECRET=change-this-ccs-admin-secret

# Admin belépés élettartama másodpercben (alapértelmezés: 12 óra).
CCS_AUTH_TTL=43200

# A látogatószámláló látogató-azonosító hashének sója (analytics).
# Nyers IP-t nem tárolunk, csak az ebből képzett hasht. STABIL só, hogy a
# "visszatérő vs. új" napok között is működjön.
# ⚠️ ÉLESBEN cseréld le: openssl rand -hex 32
CCS_ANALYTICS_SALT=change-this-ccs-analytics-salt

# GeoLite2 ONLINE web service (geoip2 library). A látogatók országát a
# MaxMind-tól kérdezzük le HTTPS-en, helyi adatbázis nélkül.
# Ingyenes GeoLite2 fiók kell hozzá: https://www.maxmind.com/en/geolite2/signup
# A fiókban hozz létre egy license key-t. Ha ezek üresek, a számláló ország
# nélkül, egyébként hibátlanul működik.
CCS_GEOIP_ACCOUNT_ID=
CCS_GEOIP_LICENSE_KEY=
# A web service hosztja (alapértelmezés: az ingyenes GeoLite2 végpont).
CCS_GEOIP_HOST=geolite.info
